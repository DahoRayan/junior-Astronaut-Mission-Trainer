{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "home": {
      "root": "home"
    },
    "game": {
      "root": "game",
      "framework": "vite"
    },
    "frontend-3d": {
      "root": "frontend-3d",
      "framework": "vite"
    },
    "ai-service": {
      "root": "ai-service",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/v1/(.*)",
      "destination": {
        "service": "ai-service"
      }
    },
    {
      "source": "/frontend-3d/(.*)",
      "destination": {
        "service": "frontend-3d"
      }
    },
    {
      "source": "/frontend-3d",
      "destination": {
        "service": "frontend-3d"
      }
    },
    {
      "source": "/game/(.*)",
      "destination": {
        "service": "game"
      }
    },
    {
      "source": "/game",
      "destination": {
        "service": "game"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "home"
      }
    }
  ]
}
