{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "game": {
      "root": "game",
      "framework": "vite"
    },
    "frontend-3d": {
      "root": "frontend-3d",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/frontend-3d/(.*)",
      "destination": {
        "service": "frontend-3d"
      }
    },
    {
      "source": "/frontend-3d",
      "destination": {
        "service": "frontend-3d"
      }
    },
    {
      "source": "/game/(.*)",
      "destination": {
        "service": "game",
        "path": "/play.html"
      }
    },
    {
      "source": "/game",
      "destination": {
        "service": "game",
        "path": "/play.html"
      }
    },
    {
      "source": "/play.html",
      "destination": {
        "service": "game",
        "path": "/play.html"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "game"
      }
    }
  ]
}
