{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NASAOpenAPIsResponseSchema",
  "type": "object",
  "properties": {
    "marsRoverPhotos": {
      "type": "object",
      "properties": {
        "photos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "integer" },
              "sol": { "type": "integer" },
              "camera": { "type": "object", "properties": { "name": { "type": "string" }, "full_name": { "type": "string" } } },
              "img_src": { "type": "string", "format": "uri" },
              "earth_date": { "type": "string" }
            },
            "required": ["id", "sol", "img_src"]
          }
        }
      }
    },
    "apod": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "explanation": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "date": { "type": "string" }
      },
      "required": ["title", "explanation", "url"]
    }
  }
}

