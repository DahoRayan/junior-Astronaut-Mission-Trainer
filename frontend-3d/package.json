{
  "name": "frontend-3d",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "tsx --test tests/**/*.test.ts",
    "test:e2e": "tsx --test tests/e2e/**/*.test.ts",
    "test:e2e:tier1": "tsx --test tests/e2e/tier1-feature-coverage/*.test.ts",
    "test:e2e:tier2": "tsx --test tests/e2e/tier2-boundary-cases/*.test.ts",
    "test:e2e:tier3": "tsx --test tests/e2e/tier3-cross-feature/*.test.ts",
    "test:e2e:tier4": "tsx --test tests/e2e/tier4-real-world-scenarios/*.test.ts",
    "test:e2e:report": "tsx tests/e2e/harness/runner.ts",
    "download:assets": "node scripts/download-assets.mjs",
    "verify": "node scripts/verify-m1.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
