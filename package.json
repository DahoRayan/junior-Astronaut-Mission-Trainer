{
  "name": "j-astro",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "game",
    "frontend-3d"
  ],
  "scripts": {
    "build": "node scripts/build-vercel.mjs",
    "build:2d": "npm --prefix game run build",
    "build:3d": "npm --prefix frontend-3d run build",
    "dev": "npm --prefix game run dev",
    "dev:2d": "npm --prefix game run dev",
    "dev:3d": "npm --prefix frontend-3d run dev",
    "dev:all": "node scripts/start-both.mjs",
    "home": "node scripts/serve-home.mjs",
    "test": "npm --prefix game test"
  }
}
